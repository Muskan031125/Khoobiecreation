#--------------------------------------------------------------------
# Khoobie production .env template
#--------------------------------------------------------------------
# Copy to .env on the server, fill in real values, never commit.
# Most fields are auto-filled by setup.php on first install.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL                       = 'https://khoobie.com/'
app.indexPage                     = ''
app.forceGlobalSecureRequests     = true
app.CSPEnabled                    = false
app.appTimezone                   = 'Asia/Kolkata'
app.defaultLocale                 = 'en'

#--------------------------------------------------------------------
# BRAND
#--------------------------------------------------------------------
khoobie.brand_name                = 'Khoobie Creations'
khoobie.brand_short               = 'Khoobie'
khoobie.brand_tagline             = 'Screen-free learning kids actually love.'
khoobie.brand_domain              = 'khoobie.com'
khoobie.support_email             = 'hello@khoobie.com'
khoobie.support_phone             = '+91 88992 23300'
khoobie.support_whatsapp          = '918899223300'
khoobie.gstin                     = ''
khoobie.company_name              = 'Khoobie Creations'
khoobie.company_address           = 'B-110, Sector 69, Noida, Uttar Pradesh 201307'

#--------------------------------------------------------------------
# DATABASE — use a non-root user in production
#--------------------------------------------------------------------
database.default.hostname         = 127.0.0.1
database.default.database         = khoobie
database.default.username         = khoobie_app
database.default.password         = 'CHANGE_ME_strong_random'
database.default.DBDriver         = MySQLi
database.default.DBPrefix         =
database.default.port             = 3306
database.default.charset          = utf8mb4
database.default.DBCollat         = utf8mb4_unicode_ci
database.default.DBDebug          = false

#--------------------------------------------------------------------
# SECURITY — encryption key is REQUIRED; generate via:
#   php -r "echo bin2hex(random_bytes(32));"
#--------------------------------------------------------------------
encryption.key                    = 'CHANGE_ME_64_hex_chars'

#--------------------------------------------------------------------
# COOKIES — HTTPS only
#--------------------------------------------------------------------
cookie.secure                     = true
cookie.httponly                   = true
cookie.samesite                   = Lax

#--------------------------------------------------------------------
# SESSION — file driver works on single server. For multi-server,
# switch to redis: 'CodeIgniter\Session\Handlers\RedisHandler'
#--------------------------------------------------------------------
session.driver                    = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName                = 'khoobie_session'
session.expiration                = 7200
session.savePath                  = '/var/www/khoobie/writable/session'
session.matchIP                   = false

#--------------------------------------------------------------------
# LOGGING — 4 = warnings + errors only (less noisy on prod)
#--------------------------------------------------------------------
logger.threshold                  = 4

#--------------------------------------------------------------------
# MAIL — Zoho / SendGrid / AWS SES / Brevo
#--------------------------------------------------------------------
mail.smtp_host                    = 'smtp.zoho.in'
mail.smtp_port                    = 587
mail.smtp_user                    = 'hello@khoobie.com'
mail.smtp_pass                    = 'CHANGE_ME'
mail.from_email                   = 'hello@khoobie.com'
mail.from_name                    = 'Khoobie'

#--------------------------------------------------------------------
# PAYMENT GATEWAYS
#--------------------------------------------------------------------
razorpay.key_id                   = 'rzp_live_xxxxxxxxxxxxxx'
razorpay.key_secret               = 'CHANGE_ME'
razorpay.webhook_secret           = 'CHANGE_ME'

phonepe.merchant_id               = ''
phonepe.salt_key                  = ''
phonepe.salt_index                = 1

#--------------------------------------------------------------------
# SHIPROCKET
#--------------------------------------------------------------------
shiprocket.email                  = ''
shiprocket.password               = ''

#--------------------------------------------------------------------
# AI / LLM PROVIDERS (swappable — set khoobie.llm_provider = claude|gpt|gemini|kimi)
#--------------------------------------------------------------------
khoobie.llm_provider              = 'claude'
anthropic.api_key                 = ''
openai.api_key                    = ''
google.gemini_api_key             = ''
kimi.api_key                      = ''

#--------------------------------------------------------------------
# WHATSAPP BUSINESS API (Meta Cloud API)
#--------------------------------------------------------------------
whatsapp.phone_id                 = ''
whatsapp.access_token             = ''

#--------------------------------------------------------------------
# WEB PUSH (VAPID — generate via: npx web-push generate-vapid-keys)
#--------------------------------------------------------------------
webpush.public_key                = ''
webpush.private_key               = ''
webpush.subject                   = 'mailto:hello@khoobie.com'

#--------------------------------------------------------------------
# TRACKING PIXELS
#--------------------------------------------------------------------
tracking.meta_pixel_id            = ''
tracking.meta_capi_token          = ''
tracking.ga_measurement_id        = ''
